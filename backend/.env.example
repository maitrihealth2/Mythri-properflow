# Database Configuration
DATABASE_URL=sqlite:///./affyne_mythri.db

# Authentication — must be a strong random secret in production
SECRET_KEY=changethis_to_a_64_char_random_hex

# Firebase
FIREBASE_API_KEY=your_firebase_api_key_here

# AI Engine
SARVAM_API_KEY=your_sarvam_api_key_here

# Error tracking — Sentry DSN (never hardcode; leave blank to disable)
SENTRY_DSN=

# Environment mode: development | staging | production
# In production: /docs, /redoc, /openapi.json are disabled
ENVIRONMENT=development

# Admin credentials — BOTH must be set explicitly; no defaults
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Feature flags
SHOW_TOKEN_USAGE=true

# Security & Encryption (AES-256-GCM Field-Level Encryption)
# 32-byte hex (64 chars) or base64. If omitted, derived from SECRET_KEY via HKDF-SHA256
FIELD_ENCRYPTION_KEY=

# Allowed CORS Origins (comma-separated for production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Offsite Backup Encryption Key (Optional 32-byte hex)
BACKUP_ENCRYPTION_KEY=

